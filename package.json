{
  "name": "hrudaya",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:types": "supabase gen types --lang=typescript --project-id \"$SUPABASE_PROJECT_REF\" --schema public > lib/database.types.ts",
    "seed": "node --env-file=.env.local scripts/seed.ts",
    "fhir:verify-codes": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/fhir-verify-codes.ts",
    "test": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON lib/fhir/*.test.ts lib/summary/input.test.ts lib/summary/audit.test.ts lib/summary/generate.test.ts lib/summary/api.test.ts lib/summary/markdown.test.ts",
    "fhir:validate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env.local scripts/fhir-validate.ts",
    "fhir:hapi": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env.local scripts/fhir-hapi.ts",
    "test:seeded": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env.local lib/summary/input.seeded.test.ts",
    "summary:eval": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env.local scripts/summary-eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/fhir": "^0.0.44",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
